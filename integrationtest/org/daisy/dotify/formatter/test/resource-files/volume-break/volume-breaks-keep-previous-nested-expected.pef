<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-01</dc:date>
<dc:title>Volume keep with previous, nested blocks test</dc:title>
<dc:description>Tests keep-with-previous-sheets on nested blocks that end on the same sheet. One short block is one sheet. A block with keep-with-previous-sheets=&quot;2&quot; occupies sheets 8-11. Its last child, with keep-with-previous-sheets=&quot;1&quot;, occupies sheets 10-11. Without the keep-with-previous-sheets, the first volume would be 10 sheets and the second would be 4 sheets. The child keeps sheets 10 and 11 together, and the parent keeps sheets 9, 10 and 11 together, so the first volume is 8 sheets and the second 6 sheets.</dc:description>
</meta>
</head>
