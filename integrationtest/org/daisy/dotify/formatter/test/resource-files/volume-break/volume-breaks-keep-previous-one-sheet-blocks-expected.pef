<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-01</dc:date>
<dc:title>Volume keep with previous, one-sheet blocks test</dc:title>
<dc:description>Tests that keep-with-previous-sheets on blocks that fit on one sheet has no effect. Each of the 14 blocks has break-before=&quot;sheet&quot; and keep-with-previous-sheets=&quot;1&quot;, and fits on one sheet. The third block starts with a sheet without content rows, so the book has 15 sheets. The keep-with-previous-sheets only applies within each block, so the volumes are 10 and 5 sheets.</dc:description>
</meta>
</head>
