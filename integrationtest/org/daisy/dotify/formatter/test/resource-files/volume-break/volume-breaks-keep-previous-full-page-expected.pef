<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-15</dc:date>
<dc:title>Volume keep with previous, full last page test</dc:title>
<dc:description>One short block is one sheet. The block with keep-with-previous-sheets=&quot;1&quot; has three children and fills sheets 3-5. Its last page is full, so the block ends exactly where the next block starts. The keep must still apply to the block's own last sheet, not to the next block. Without the keep, the volumes would be 4 and 3 sheets. With it, they are 3 and 4 sheets.</dc:description>
</meta>
</head>
