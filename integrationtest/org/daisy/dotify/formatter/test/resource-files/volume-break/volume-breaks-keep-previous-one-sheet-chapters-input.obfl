<obfl xmlns="http://www.daisy.org/ns/2011/obfl" version="2011-1" xml:lang="en">
	<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
		<dc:title>Volume keep with previous, one-sheet chapters test</dc:title>
		<dc:description>Seven chapters with break-before="sheet" and keep-with-previous-sheets="1", each fitting on one
		sheet. Chapter 3 starts with a sheet without content rows, so the book has 8 sheets. A chapter that fits on
		one sheet has nothing to keep, so the volumes are 4 and 4 sheets.</dc:description>
	</meta>
	<layout-master name="body" page-width="10" page-height="6" duplex="false">
		<default-template>
			<header/>
			<footer/>
		</default-template>
	</layout-master>
	<volume-template sheets-in-volume-max="4">
		<pre-content/>
		<post-content/>
	</volume-template>
	<sequence master="body">
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1" margin-top="2">
			<marker class="pagenum" value="1"/>
			<block break-before="sheet">⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
		<block break-before="sheet" keep-with-previous-sheets="1">
			<block>⠿⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠤ ⠤⠿</block>
		</block>
	</sequence>
</obfl>
