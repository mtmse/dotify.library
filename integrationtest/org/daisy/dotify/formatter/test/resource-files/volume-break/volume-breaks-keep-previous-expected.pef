<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-01</dc:date>
<dc:title>Volume keep with previous test</dc:title>
<dc:description>Tests that keep-with-previous-sheets keeps the end of a block with its previous sheet. One short block is one sheet. A 5-sheet block with keep-with-previous-sheets=&quot;1&quot; occupies sheets 7-11. Without the keep-with-previous-sheets, the first volume would be 10 sheets (the target size) and the second would be 4 sheets, starting with the last sheet of the block. With the keep-with-previous-sheets, the first volume is 9 sheets and the second 5 sheets.</dc:description>
</meta>
</head>
