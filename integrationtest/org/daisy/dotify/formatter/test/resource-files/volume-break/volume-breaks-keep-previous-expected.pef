<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-15</dc:date>
<dc:title>Volume keep with previous test</dc:title>
<dc:description>One short block is one sheet. The block with keep-with-previous-sheets=&quot;2&quot; fills sheets 4-5. Without the keep, the volumes would be 4 and 3 sheets, and volume 2 would start with the block's last sheet. The keep applies to the end of the block, but only to the block's own sheets: sheet 4 is kept with sheet 5, sheet 3 is not. So the volumes are 3 and 4 sheets.</dc:description>
</meta>
</head>
