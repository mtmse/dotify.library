<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-01</dc:date>
<dc:title>Volume keep with previous, larger than block test</dc:title>
<dc:description>Tests that keep-with-previous-sheets never reaches before the start of the block. One short block is one sheet. A 2-sheet block with keep-with-previous-sheets=&quot;2&quot; occupies sheets 10-11. The block only has one sheet before its last sheet, so only that sheet is kept with it. Without the keep-with-previous-sheets, the first volume would be 10 sheets and the second would be 4 sheets. With the keep-with-previous-sheets, the first volume is 9 sheets and the second 5 sheets.</dc:description>
</meta>
