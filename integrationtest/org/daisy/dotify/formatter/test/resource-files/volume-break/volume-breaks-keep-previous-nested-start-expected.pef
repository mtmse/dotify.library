<?xml version="1.0" encoding="UTF-8"?>
<pef version="2008-1" xmlns="http://www.daisy.org/ns/2008/pef">
<head>
<meta xmlns:dc="http://purl.org/dc/elements/1.1/">
<dc:format>application/x-pef+xml</dc:format>
<dc:identifier>identifier?</dc:identifier>
<dc:date>2026-10-01</dc:date>
<dc:title>Volume keep with previous, nested block at start test</dc:title>
<dc:description>Tests that keep-with-previous-sheets on a nested block does not reach before the start of the nested block. One short block is one sheet. A 4-sheet block with keep-with-previous-sheets=&quot;1&quot; starts right after the target size of the first volume. Its first child fits on one sheet and also has keep-with-previous-sheets=&quot;1&quot;. Neither keep reaches before the start of its own block, so the volumes are 10 and 4 sheets.</dc:description>
</meta>
</head>
